# setup scripts create .env and generate WORKER_TOKEN; never commit .env.
WORKBENCH_PORT=8765
EVIDENCE_PATH=./examples
WORKER_TOKEN=replace-with-generated-random-token
WORKBENCH_TOKEN=
MODEL_API_KEY=
MODEL_TIMEOUT=300
OPENRELIK_URL=
OPENRELIK_TOKEN=
EWF_TIMEOUT=7200
WORKER_TIMEOUT=14400

# Large Linux E01 parsing; raise for larger filesystems if necessary
WORKER_MEMORY=4g
HUNT_BUDGET_GIB=8
INVESTIGATION_MODEL_CALLS=12
